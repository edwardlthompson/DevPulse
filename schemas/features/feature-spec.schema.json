{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Feature spec markdown contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["required_h2", "skip_basenames", "command_must_contain"],
  "properties": {
    "required_h2": {
      "type": "array",
      "minItems": 5,
      "items": { "type": "string", "minLength": 3 }
    },
    "skip_basenames": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "command_must_contain": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
