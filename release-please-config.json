{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "simple",
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        {
          "type": "generic",
          "path": ".template-version"
        },
        {
          "type": "json",
          "path": "TEMPLATE_INDEX.json",
          "jsonpath": "$.template_version"
        },
        {
          "type": "yaml",
          "path": "CITATION.cff",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": ".cursor-plugin/plugin.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "schemas/golden-path/app-version.json",
          "jsonpath": "$.version"
        }
      ],
      "include-component-in-tag": false,
      "include-v-in-tag": true
    }
  },
  "changelog-sections": [
    {
      "type": "feat",
      "section": "Added"
    },
    {
      "type": "fix",
      "section": "Fixed"
    },
    {
      "type": "perf",
      "section": "Changed"
    },
    {
      "type": "revert",
      "section": "Changed"
    },
    {
      "type": "docs",
      "section": "Documentation"
    },
    {
      "type": "chore",
      "section": "Changed"
    }
  ]
}
