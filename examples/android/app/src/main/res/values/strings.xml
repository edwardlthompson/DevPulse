    <string name="play_lookup_title">Google Play lookup</string>
    <string name="play_lookup_body">Refresh checks Play via Aurora’s FOSS API (same catalog). HTML is only a fallback. On by default.</string>
    <string name="play_lookup_enable">Look up listings on Google Play</string>
    <string name="aurora_play_enable">Download Play updates via Aurora</string>
    <string name="aurora_play_body">Off by default. Update can download via Aurora or open the Play Store. You do not need the Aurora Store app. The anonymous token is stored encrypted and never logged.</string>
    <string name="forge_lookup_title">GitHub lookup</string>
    <string name="forge_lookup_body">Refresh lists GitHub from F-Droid source links. On by default. A token is optional but avoids rate limits — follow the steps below.</string>
    <string name="forge_lookup_enable">Look up listings on GitHub</string>
    <string name="forge_lookup_search_unknowns">Search GitHub when F-Droid has no source link</string>
    <string name="forge_lookup_search_unknowns_body">Off by default. Uses GitHub search quota. A token helps avoid rate limits.</string>
    <string name="aptoide_title">Aptoide last-release lookup</string>
    <string name="aptoide_body">Optional. Refresh may send unmatched package names to Aptoide. Off by default. Aptoide Games is not the store client — install Aptoide Store from the store apps section.</string>
    <string name="aptoide_enable">Look up last release on Aptoide</string>
    <string name="dump_store_title">APKMirror and APKPure</string>
    <string name="dump_store_body">Optional. Refresh may send package names to these dump sites. Dates are last seen there, not maintainer activity. Off by default. APKPure can download a matching APK file when the update JSON has asset.url.</string>
    <string name="apkmirror_enable">Look up listings on APKMirror</string>
    <string name="apkpure_enable">Look up listings on APKPure</string>
